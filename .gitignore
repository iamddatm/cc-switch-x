node_modules/
# Qoder 本地 worktree 与会话元数据
.qoder/
# superpowers 会话 scratch：brainstorm 预览页与 SDD ledger（设计与计划文档已进 docs/superpowers，不需要入库）
.superpowers/
dist/
src-tauri/target/
*.tsbuildinfo
references/
index.db
index.db-*
secrets.local.json
local/
backups/
logs/
state/
# 上面四条是无位置限定的兜底，目的是别让 store 数据入库；但它们也会连源码目录一起
# 吞掉（src/components/backups/ 就曾被静默忽略到无法 add）。放行规则必须排在后面，
# git 是后匹配的规则赢。
!src/**/local/
!src/**/backups/
!src/**/logs/
!src/**/state/
# 发布产物、updater 签名私钥与本地联调配置
release-assets/
*.key
*.key.pub
*.key.password
src-tauri/tauri.updater-local.conf.json
# Agy 会话夹具复刻真实目录（.system_generated/logs/），排除项要穿透上面的 logs/ 规则
!src-tauri/tests/fixtures/sessions/agy/**/logs/
!src-tauri/tests/fixtures/sessions/agy/**/logs/**
